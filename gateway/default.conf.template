# Gateway config to access both frontend and backend dev server under a same host.
# The nginx image runs envsubst on this file. It only replaces variables that
# exist in the container (CARBURE_FRONTEND_HOST, CARBURE_BACKEND_HOST).
# $host and $remote_addr are nginx variables and stay as written.
server {
    listen 80;
    server_name carbure_gateway;
    charset utf-8;
    client_max_body_size 10M;

    # access frontend dev server on /
    location / {
        proxy_pass http://${CARBURE_FRONTEND_HOST}:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

     # proxy requests to frontend static assets
    location /static {
        proxy_pass http://${CARBURE_FRONTEND_HOST}:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # reserve admin and api for the backend
    location ~ ^/(admin|api|silk|assets) {
        proxy_pass http://${CARBURE_BACKEND_HOST}:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location /ws {
        proxy_pass  http://${CARBURE_FRONTEND_HOST}:3000;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
