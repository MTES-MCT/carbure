# Parameters for the second local environment. Defaults in docker-compose.yml
# stay on the main one; this file only overrides what must differ.
CARBURE_FRONTEND_CONTAINER=carbure_agent_frontend
CARBURE_APP_CONTAINER=carbure_agent_app
CARBURE_PROXY_CONTAINER=carbure_agent_web
WEB_PORT=8190
CARBURE_DATABASE=carbure_agent
REDIS_DB=1
AWS_ENV_FOLDER_NAME=carbure-agent
UPLOADED_FILES_VOLUME=carbure_agent_uploadedfiles
