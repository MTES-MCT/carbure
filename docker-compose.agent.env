# Values specific to the agent. `make up` does not load this file and keeps
# the defaults written in docker-compose.yml.
# Docker allows only one container of each name on the machine.
CARBURE_FRONTEND_CONTAINER=carbure_agent_frontend
CARBURE_APP_CONTAINER=carbure_agent_app
CARBURE_PROXY_CONTAINER=carbure_agent_web
# Published port. Cookies are stored per hostname, not per port: open the agent
# on http://carbure-agent.local:8190, otherwise a login here logs you out of :8090.
WEB_PORT=8190
# Overrides MYSQL_DATABASE from .env for this Compose run. Django reads it in DATABASE_URL.
# The MySQL container keeps the value from the .env file.
MYSQL_DATABASE=carbure_agent
# Logical index of the shared Redis, for the Django cache only.
REDIS_DB=1
# S3 key prefix (AWS_LOCATION). The bucket stays the shared mock.
AWS_ENV_FOLDER_NAME=carbure-agent
# Uploaded files. Separate volume from the main environment.
UPLOADED_FILES_VOLUME=carbure_agent_uploadedfiles
