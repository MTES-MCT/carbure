msgstr "Charge point %(charge_point_id)s already exists"

#: web/elec/services/import_charge_point_excel.py:150
#, python-format
msgid ""
"Le point de recharge %(charge_point_id)s n'est pas listé dans les données "
"consolidées de transport.data.gouv.fr"
msgstr ""
"The charge point %(charge_point_id)s is not listed in the consolidated data "
"from transport.data.gouv.fr"

#: web/elec/services/import_charge_point_excel.py:156
msgid "La puissance nominale est obligatoire"
msgstr "The nominal power is mandatory"

#: web/elec/services/import_charge_point_excel.py:162
msgid ""
"L'identifiant du point de mesure est obligatoire pour les stations ayant au "
"moins un point de recharge en courant continu."
msgstr ""
"The identifier of the measuring point is mandatory for stations with at "
"least one DC charge point."

#: web/elec/services/import_charge_point_excel.py:167
msgid "Le numéro MID est obligatoire."
msgstr "MID number is mandatory."

#: web/elec/services/import_charge_point_excel.py:169
msgid "La date du dernier relevé est obligatoire."
msgstr "Date of the last reading is mandatory."

#: web/elec/services/import_charge_point_excel.py:171
msgid "L'énergie mesurée lors du dernier relevé est obligatoire."
msgstr "Mesured energy during the last reading is mandatory."

#: web/elec/services/import_elec_audit_report_excel.py:98
#, python-format
msgid ""
"Le point de charge %(charge_point_id)s ne fait pas partie de l'échantillon "
"sélectionné pour cet audit."
msgstr ""
"The charge point %(charge_point_id)s is not part of the sample selected for "
"this audit."

#: web/elec/services/import_elec_audit_report_excel.py:117
#, python-format
msgid ""
"Les informations relatives au point de charge %(charge_point_id)s sont "
"incomplètes ou absentes."
msgstr ""
"Information about charge point %(charge_point_id)s is incomplete or missing."

#: web/elec/services/import_meter_reading_excel.py:140
msgid "Le point de recharge n'a pas encore été inscrit sur la plateforme."
msgstr "The charge point has not yet been registered on the platform."

#: web/elec/services/import_meter_reading_excel.py:146
msgid ""
"Ce point de recharge n'a pas de compteur associé, veuillez en ajouter un "
"depuis la page dédiée."
msgstr ""
"This charge point has no associated meter. Please add one from the "
"dedicated page."

#: web/elec/services/import_meter_reading_excel.py:150
msgid "La quantité d'énergie soutirée est inférieure au précédent relevé."
msgstr "The amount of energy withdrawn is less than the previous reading."

#: web/elec/services/import_meter_reading_excel.py:155
#, python-format
msgid "Ce point de recharge a été défini %(count)d fois (lignes %(lines)s)"
msgstr "This charge point has been defined %(count)d times (lines %(lines)s)"

#: web/elec/services/import_meter_reading_excel.py:162
#, python-format
msgid ""
"Un relevé plus récent est déjà enregistré pour ce point de recharge: "
"%(energy)gkWh, %(date)s"
msgstr ""
"A more recent reading is already recorded for this charge point: "
"%(energy)gkWh, %(date)s"

#: web/elec/services/import_meter_reading_excel.py:170
msgid ""
"Le facteur de charge estimé depuis le dernier relevé enregistré est "
"supérieur à 100%. Veuillez vérifier les valeurs du relevé ainsi que la "
"puissance de votre point de recharge, renseignée sur TDG."
msgstr ""
"The estimated load factor since the last recorded reading is greater than "
"100%. Please check the values of the reading as well as the power of your "
"charge point, entered on TDG."

#: web/elec/services/import_meter_reading_excel.py:177
msgid ""
"Ce point de recharge n'est pas soumis aux relevés trimestriels, veuillez le "
"supprimer du fichier."
msgstr ""
"This charge point is not subject to quarterly readings. Please remove it "
"from the file."

#: web/elec/services/import_meter_reading_excel.py:183
msgid "La date du relevé ne correspond pas au trimestre traité actuellement."
msgstr "The reading date does not correspond to the current quarter."

