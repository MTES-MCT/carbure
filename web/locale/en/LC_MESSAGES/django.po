#: web/biomethane/services/contract.py:69
msgid ""
"Pour la référence tarifaire 2011, la date de signature doit être entre le "
"23/11/2011 et le 23/11/2020."
msgstr ""
"For the 2011 tariff reference, the signing date must be between 23/11/2011 "
"and 23/11/2020."

#: web/biomethane/services/contract.py:74
msgid ""
"Pour la référence tarifaire 2020, la date de signature doit être entre le "
"23/11/2020 et le 13/12/2021."
msgstr ""
"For the 2020 tariff reference, the signing date must be between 23/11/2020 "
"and 13/12/2021."

#: web/biomethane/services/contract.py:79
msgid ""
"Pour la référence tarifaire 2021, la date de signature doit être entre le "
"13/12/2021 et le 10/06/2023."
msgstr ""
"For the 2021 tariff reference, the signing date must be between 13/12/2021 "
"and 10/06/2023."

#: web/biomethane/services/contract.py:101
msgid "La date d'effet doit être postérieure à la date de signature."
msgstr "The effective date must be after the signing date."

#: web/biomethane/services/contract.py:118
msgid ""
"Pour la référence tarifaire 2023, la date de signature doit être "
"postérieure au 10/06/2023."
msgstr ""
"For the 2023 tariff reference, the signing date must be after 10/06/2023."

